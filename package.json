{
    "name": "sat-track",
    "version": "2.0.0",
    "description": "Real-time 3D satellite constellation tracker",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
        "lint": "eslint src/ tests/",
        "lint:fix": "eslint src/ tests/ --fix",
        "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.json\" \"*.md\" \"*config.js\"",
        "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.json\" \"*.md\" \"*config.js\"",
        "test:browser": "playwright test"
    },
    "dependencies": {
        "satellite.js": "6.0.2",
        "three": "^0.172.0"
    },
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "@playwright/test": "1.63.0",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.0",
        "vite": "^6.2.0"
    },
    "jest": {
        "transform": {},
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    },
    "license": "MIT",
    "engines": {
        "node": ">=24 <25"
    }
}
